{
    "name": "koffielyder/laravel-ai-model",
    "description": "Easily extend Laravel models with AI-powered creation of database entries and related entities.",
    "keywords": ["laravel", "ai", "model", "openai", "generator"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Koffielyder\\LaravelAiModel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koffielyder\\LaravelAiModel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Koffielyder\\LaravelAiModel\\AiModelServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "koffielyder",
            "email": "nico.g.shultz@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
